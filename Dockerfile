# 1. استخدام نسخة مستقرة وخفيفة من Node.js
FROM node:20-alpine

# 2. إنشاء مجلد العمل داخل حاوية السيرفر
WORKDIR /usr/src/app

# 3. نسخ ملفات الحزم والمكتبات المطلوبة
COPY package*.json ./

# 4. تثبيت المكتبات البرمجية داخل السيرفر بأمان
RUN npm install

# 5. نسخ كافة ملفات مشروعك (index.html, server.js) إلى الحاوية
COPY . .

# 6. فتح المنفذ 3000 لكي يتواصل السيرفر مع العالم الخارجي
EXPOSE 3000

# 7. الأمر النهائي لتشغيل المتجر والبوت تلقائياً
CMD ["npm", "start"]
